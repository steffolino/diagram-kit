{
  "name": "@steffolino/diagram-kit-cli",
  "version": "0.1.1",
  "description": "Command-line rendering for diagram-kit: turn YAML/JSON/Mermaid/tree/directory input into an SVG or PNG diagram without writing any code.",
  "license": "MIT",
  "author": "Stefan Stretz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steffolino/diagram-kit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/steffolino/diagram-kit/tree/master/packages/cli#readme",
  "bugs": "https://github.com/steffolino/diagram-kit/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["diagram", "cli", "svg", "png", "graph", "visualization"],
  "type": "module",
  "bin": {
    "diagram-kit": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@steffolino/diagram-kit-adapters": "workspace:*",
    "@steffolino/diagram-kit-core": "workspace:*",
    "@steffolino/diagram-kit-static": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
