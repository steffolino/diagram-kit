{
  "name": "@steffolino/diagram-kit-static",
  "version": "0.1.1",
  "description": "Headless SVG/PNG export for diagram-kit graphs, for slides and presentations rather than embedding.",
  "license": "MIT",
  "author": "Stefan Stretz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steffolino/diagram-kit.git",
    "directory": "packages/static"
  },
  "homepage": "https://github.com/steffolino/diagram-kit/tree/master/packages/static#readme",
  "bugs": "https://github.com/steffolino/diagram-kit/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["diagram", "svg", "png", "export", "static"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "default": "./dist/png.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@steffolino/diagram-kit-core": "workspace:*",
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
